<?xml version="1.0"?>
<package format="3">
  <name>stereo_recon</name>
  <version>0.1.0</version>
  <description>Standalone stereo dense reconstruction with SGBM and optional IGEV/S2M2 TensorRT backends.</description>
  <maintainer email="sunke.polyu@gmail.com">Ke Sun</maintainer>
  <license>Penn Software License</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>python3-numpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
